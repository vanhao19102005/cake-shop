<article class="product-card">
  <a class="product-image" href="/products/<%= product.id %>">
    <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" onerror="this.onerror=null;this.src='/images/placeholder.svg';">
    <% if (product.tag) { %>
      <span class="sale-tag">SALE</span>
    <% } %>
  </a>
  <div class="product-info">
    <h3><a href="/products/<%= product.id %>"><%= product.name %></a></h3>
    <div class="prices">
      <% if (product.old_price != null) { %>
        <del><%= Number(product.old_price).toLocaleString('vi-VN') %> đ</del>
      <% } %>
      <strong><%= Number(product.price).toLocaleString('vi-VN') %> đ</strong>
    </div>
    <div class="card-actions">
      <button class="cart-button" type="button" data-product-name="<%= product.name %>" aria-label="Thêm <%= product.name %> vào giỏ hàng">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 3h2l3 12h11l2-8H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
      </button>
      <a class="details-button" href="/products/<%= product.id %>">Details <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
